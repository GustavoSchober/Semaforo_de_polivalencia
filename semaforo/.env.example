# Postgres local, em contêiner (ver README do projeto)
DATABASE_URL=postgres://semaforo:dev@localhost:5432/semaforo

# Usuário com mais privilégio, usado SÓ no momento das migrations (ADR-006).
# Em desenvolvimento pode ser o mesmo; em produção, não.
DATABASE_URL_MIGRACAO=postgres://semaforo:dev@localhost:5432/semaforo

# Segredo de sessão do Auth.js. Gere com: openssl rand -base64 32
AUTH_SECRET=
